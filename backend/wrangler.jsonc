{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "untitled-faith-proxy",
  "account_id": "c0f96de71bdc54889c1ad27ccc90dfc0",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["*/15 * * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "untitled-faith-users", "database_id": "599fc9a3-1546-443b-b9bd-27dfb65c4240", "migrations_dir": "migrations" }
  ],
  "vars": {
    "APPLE_CLIENT_ID": "com.lukefournier.UntitledFaith",
    "APPLE_TEAM_ID": "BZT8F2M765",
    "APPLE_KEY_ID": "4ADZN888UW",
    "PAYMENTS_ENABLED": "true",
    "STRIPE_MODE": "live",
    "PAYMENT_OWNER_ACCOUNT_ID": "59a6519c-b51b-40dc-8f16-b2f06928f96a",
    "PAYMENT_PUBLIC_ORIGIN": "https://untitled-faith-proxy.vendors-c0f.workers.dev"
  },
  "secrets": { "required": ["OPENROUTER_API_KEY", "SESSION_SIGNING_KEY", "SESSION_ENCRYPTION_KEY", "APPLE_PRIVATE_KEY", "STRIPE_SECRET_KEY", "STRIPE_WEBHOOK_SECRET"] },
  "ratelimits": [
    { "name": "ANSWERS_RATE_LIMITER", "namespace_id": "90817001", "simple": { "limit": 10, "period": 60 } },
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "90817002", "simple": { "limit": 10, "period": 60 } },
    { "name": "PASSAGES_RATE_LIMITER", "namespace_id": "90817003", "simple": { "limit": 20, "period": 60 } }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
